# NafuPlanner web - ortam degiskenleri ornegi.
# Bu dosyayi ".env" olarak kopyalayip degerleri doldur. ".env" commit edilmez.

# Google OAuth istemci kimligi (Google Cloud Console > Kimlik bilgileri > OAuth 2.0).
# Bos birakilirsa giris ekraninda "Google girisi henuz ayarli degil" notu gosterilir.
VITE_GOOGLE_CLIENT_ID=

# API taban yolu. Ayni alan adindan sunuluyorsa "/api" yeterlidir.
# Ayri bir sunucu icin tam URL verilebilir (ornek: https://api.alanadi.com).
VITE_API_BASE=/api
