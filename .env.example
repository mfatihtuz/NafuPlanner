# ----------------------------------------------------------------------------
# Nafu Planlayıcı — ortam değişkenleri
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
#
# NOT: EXPO_PUBLIC_ önekli değişkenler istemci uygulamaya gömülür. Bunlar
# "gizli sır" DEĞİLDİR (Firebase web anahtarı ve OAuth client ID'leri doğası
# gereği herkese açıktır). Asıl gizli olanlar (service-account JSON, FCM server
# key) yalnızca Cloud Functions tarafında durur, repoya GİRMEZ.
# ----------------------------------------------------------------------------

# Firebase Web SDK config
# Firebase Console > Project settings > General > Your apps > Web app > SDK config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google OAuth client ID'leri (Google ile Giriş)
# Web client ID zaten elimizde:
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=338527787669-h95jj4kok8n5merse6qcbr86vrif4fs7.apps.googleusercontent.com
# iOS için: Google Cloud Console > Credentials > "iOS" tipinde OAuth client oluştur
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android için (sonraki aşama):
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS reversed client id (com.googleusercontent.apps.XXXX) — native yönlendirme şeması
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# EAS proje kimliği (eas init sonrası otomatik dolar)
EXPO_PUBLIC_EAS_PROJECT_ID=
